# 集成栈配置 (复制为 .env, docker compose 自动读取)。不入版本库 —— SEC-7
# cp .env.example .env && 编辑下方值

# Marzban sudo 管理员 (首次启动自动创建; RelayHub 用同一账号调 API)
MARZBAN_ADMIN_USER=admin
MARZBAN_ADMIN_PASS=change-me-strong-password

# 本机公网 IP (出站护栏: 防客户回打面板/SSH, SEC-5)。务必填!
LOCAL_IP=

# 出站滥用拦截开关
BLOCK_SMTP=true
BLOCK_BITTORRENT=false

# 告警 (P5, 可选)。配齐下面两项 + ALERT_INTERVAL_MIN>0 才会后台 Telegram 推送。
# Bot token 找 @BotFather 申请; chat_id 找 @userinfobot 获取。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_INTERVAL_MIN=0          # 0=关闭后台告警; 如 10 = 每10分钟自检推送
ALERT_EXPIRE_DAYS=3           # 剩余天数<=此值告警
ALERT_TRAFFIC_PCT=90          # 流量用量>=此百分比告警
ALERT_CHECK_HEALTH=false      # 告警时附带 decode 线路探活(慢, 谨慎开)
