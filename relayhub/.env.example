# RelayHub 配置 (复制为 .env, 权限 600, 不入版本库) —— SEC-7
# 环境变量前缀: RELAYHUB_

# ---- Marzban 面板 ----
RELAYHUB_MARZBAN_URL=https://your-vps-domain:8000
RELAYHUB_ADMIN_USER=admin
RELAYHUB_ADMIN_PASS=change-me

# ---- 共享 inbound (集成栈默认 VLESS-Reality) ----
RELAYHUB_SHARED_INBOUND_TAG=VLESS_REALITY
RELAYHUB_SHARED_INBOUND_PROTOCOL=vless
RELAYHUB_VERIFY_TLS=true

# ---- 出站安全护栏 (SEC-5) ----
RELAYHUB_LOCAL_IP=            # 填本机公网IP, 防客户回打面板/SSH
RELAYHUB_BLOCK_SMTP=true
RELAYHUB_BLOCK_BITTORRENT=false
