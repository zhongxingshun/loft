# 仅把订阅路径 /sub/* 暴露到公网 (HTTP 80)。面板 /dashboard /api 不经此暴露。
# 反代到内网 Marzban (自签 HTTPS, 跳过校验)。客户端用 http://<IP>/sub/<token> 拉订阅。
:80 {
	# 订阅经 RelayHub 中转 (注入出口 IP 到节点名); RelayHub 内部再取 Marzban。
	handle /sub/* {
		reverse_proxy relayhub:8080
	}
	handle {
		respond "Not Found" 404
	}
}

# RelayHub 开通面板公网入口 (自签证书 + 应用层 Basic Auth)。
# 端口 8443, 浏览器 https://<IP>:8443 访问 (自签, 点继续)。
:8443 {
	tls /certs/marzban.crt /certs/marzban.key
	reverse_proxy relayhub:8080
}
